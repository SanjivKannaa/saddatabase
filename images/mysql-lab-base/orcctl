#!/bin/bash
# orcctl start|stop|restart|status|log   -- run orchestrator (as you) with /srv/orchestrator/orchestrator.conf.json
CONF=/srv/orchestrator/orchestrator.conf.json; LOG=/var/log/mysql/orchestrator.log
alive() { pgrep -x orchestrator >/dev/null; }
case ${1:-status} in
  start)
    alive && { echo "orchestrator is already running"; exit 0; }
    [ -f "$CONF" ] || { echo "no $CONF yet (there's a sample next to it)"; exit 1; }
    python3 -c "import json; json.load(open('$CONF'))" 2>/dev/null || { echo "$CONF is not valid JSON"; python3 -c "import json; json.load(open('$CONF'))"; exit 1; }
    (cd /usr/local/orchestrator && nohup ./orchestrator --config="$CONF" http >> "$LOG" 2>&1 &)
    for i in $(seq 20); do curl -sf http://127.0.0.1:3000/api/health >/dev/null 2>&1 && { echo "orchestrator started: http://127.0.0.1:3000 (log: orcctl log)"; exit 0; }; sleep 0.5; done
    echo "orchestrator didn't come up on 127.0.0.1:3000 -- last log lines:"; tail -n 8 "$LOG"; exit 1 ;;
  stop) pkill -x orchestrator && echo "orchestrator stopped" || echo "orchestrator is not running" ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  status) alive && echo "orchestrator: running (pid $(pgrep -x orchestrator))" || echo "orchestrator: stopped" ;;
  log) tail -n "${2:-40}" "$LOG" ;;
  *) sed -n '2p' "$0" ;;
esac
