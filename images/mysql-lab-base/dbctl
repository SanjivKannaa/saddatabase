#!/bin/bash
# dbctl start|stop|restart|status [node1|node2|node3|all]   (default: all nodes that are configured)
# Each node: /etc/mysql/nodes/nodeN.cnf, data /srv/mysql/nodeN, log /var/log/mysql/nodeN.err
act=${1:-status}; target=${2:-all}
nodes() { if [ "$target" = all ]; then ls /etc/mysql/nodes/ 2>/dev/null | sed -n 's/^\(node[0-9]\)\.cnf$/\1/p'; else echo "${target/#[0-9]/node$target}"; fi; }
pidf() { echo /var/run/mysqld/$1.pid; }
alive() { [ -s "$(pidf $1)" ] && kill -0 "$(cat "$(pidf $1)")" 2>/dev/null; }
start() {
  local n=$1 cnf=/etc/mysql/nodes/$1.cnf
  [ -f "$cnf" ] || { echo "$n: no such node (no $cnf)"; return 1; }
  [ -f /etc/mysql/nodes/$n.dead ] && { echo "$n: $(cat /etc/mysql/nodes/$n.dead)"; return 1; }
  alive $n && { echo "$n is already running"; return 0; }
  if ! out=$(mysqld --defaults-file="$cnf" --daemonize 2>&1); then
    echo "$n failed to start."; [ -n "$out" ] && echo "$out" | tail -4; echo "(error log: /var/log/mysql/$n.err)"; return 1; fi
  for i in $(seq 60); do [ -S /var/run/mysqld/$n.sock ] && alive $n && { echo "$n started ($(grep -m1 '^port' "$cnf" | awk '{print "port " $3}'))"; return 0; }; sleep 0.5; done
  echo "$n did not come up; see /var/log/mysql/$n.err"; return 1
}
stop() {
  local n=$1
  alive $n || { echo "$n is not running"; return 0; }
  kill "$(cat "$(pidf $n)")"; for i in $(seq 120); do alive $n || { echo "$n stopped"; return 0; }; sleep 0.5; done; return 1
}
status() { local n=$1; if alive $n; then echo "$n: running  ($(grep -m1 '^port' /etc/mysql/nodes/$n.cnf | awk '{print "127.0.0.1:" $3}'), pid $(cat "$(pidf $n)"))"; elif [ -f /etc/mysql/nodes/$n.dead ]; then echo "$n: DOWN ($(cat /etc/mysql/nodes/$n.dead))"; else echo "$n: stopped"; fi; }
rc=0
case $act in
  start|stop|status) for n in $(nodes); do $act $n || rc=1; done ;;
  restart) for n in $(nodes); do stop $n; start $n || rc=1; done ;;
  *) sed -n '2,3p' "$0"; exit 2 ;;
esac
exit $rc
