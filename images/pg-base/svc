#!/bin/bash
# svc (backend for systemctl; not on PATH) start|stop|restart|status  (wraps pg_ctl)
L=/var/log/postgresql/postgresql.log
case $1 in
  start)   pg_ctl -D "$PGDATA" -l $L -w -t 60 start ;;
  stop)    pg_ctl -D "$PGDATA" -m fast -w stop ;;
  restart) pg_ctl -D "$PGDATA" -m fast -w stop; pg_ctl -D "$PGDATA" -l $L -w -t 60 start ;;
  status)  pg_ctl -D "$PGDATA" status ;;
  reload)  pg_ctl -D "$PGDATA" reload ;;
  pid)     pg_ctl -D "$PGDATA" status >/dev/null 2>&1 && head -1 "$PGDATA/postmaster.pid" ;;
  *) echo "usage: svc start|stop|restart|status|pid" ;;
esac
