[Unit]
Description=sadDatabase (broken-database DBA trainer), 127.0.0.1:8090, served as https://sad.db.magickite
After=network-online.target

[Service]
WorkingDirectory=%h/work/apps/saddatabase
ExecStart=/usr/bin/env uv run --frozen uvicorn app.main:app --host 127.0.0.1 --port 8090 --proxy-headers --forwarded-allow-ips 127.0.0.1
Environment=SADDB_MAX_SESSIONS=4
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
